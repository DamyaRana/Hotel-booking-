generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  role      UserRole   @default(CUSTOMER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  bookings  Booking[]
  roomHolds RoomHold[]
  payments  Payment[]
}

model Hotel {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  city        String
  address     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rooms       Room[]
}

model Room {
  id         Int    @id @default(autoincrement())
  hotelId    Int
  roomNumber String

  pricePerNight Decimal @db.Decimal(10, 2)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  bookings  BookingRoom[]
  hotel     Hotel         @relation(fields: [hotelId], references: [id])
  holds     RoomHold[]

  @@unique([hotelId, roomNumber])
  @@index([hotelId])
}

model Booking {
  id          Int           @id @default(autoincrement())
  userId      Int
  checkIn     DateTime      @db.Date
  checkOut    DateTime      @db.Date
  guestCount  Int
  roomCount   Int
  totalAmount Decimal       @db.Decimal(10, 2)
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id])
  rooms       BookingRoom[]
  paymentId Int? @unique
  payment   Payment? @relation(fields: [paymentId], references: [id])

  @@index([userId])
}

model BookingRoom {
  id            Int      @id @default(autoincrement())
  bookingId     Int
  roomId        Int
  pricePerNight Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room          Room     @relation(fields: [roomId], references: [id])

  @@unique([bookingId, roomId])
  @@index([roomId])
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

model RoomHold {
  id         Int            @id @default(autoincrement())
  userId     Int
  checkoutId String
  roomId     Int
  checkIn    DateTime       @db.Date
  checkOut   DateTime       @db.Date
  expiresAt  DateTime
  status     RoomHoldStatus @default(ACTIVE)
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id])
  room       Room           @relation(fields: [roomId], references: [id])
  payment    Payment        @relation(fields: [checkoutId], references: [checkoutId], onDelete: Cascade)
  @@index([roomId, checkIn, checkOut])
  @@index([expiresAt])
}

enum RoomHoldStatus {
  ACTIVE
  CONFIRMED
  RELEASED
  EXPIRED
}

model Payment {
  id              Int           @id @default(autoincrement())
  checkoutId      String        @unique
  userId          Int
  razorpayOrderId String?       @unique
  razorpayPaymentId String? @unique
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  expiresAt       DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  booking Booking?
  user  User       @relation(fields: [userId], references: [id])
  holds RoomHold[]
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}
